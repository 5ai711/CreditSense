server_tokens off;

# Keep the scheme a TLS-terminating proxy in front of us reports; otherwise use our own.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}
# The port the browser used (from Host), unless a proxy in front already reported one. Without it the
# backend would assume 80/443 and treat same-origin requests on another port as cross-origin.
map $http_host $host_port {
    "~:(?<p>[0-9]+)$" $p;
    default           "";
}
map $http_x_forwarded_port $forwarded_port {
    default $http_x_forwarded_port;
    ""      $host_port;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 1m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    include /etc/nginx/snippets/security-headers.conf;

    # Resolve the backend per request (cached briefly), so a restarted backend container with a
    # new address is found again instead of answering 502 until nginx restarts.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $backend_upstream ${BACKEND_URL};

    # The browser only ever talks to this origin; the API is proxied to the backend.
    location /api/ {
        proxy_pass $backend_upstream;
        # host:port and scheme as the browser used them, so the backend recognises same-origin requests
        # (a browser's Origin header includes the port; $host would drop it)
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Port $forwarded_port;
        proxy_read_timeout 300s;
        # nginx adds these for every response; drop Spring Security's copies to avoid duplicates
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Hashed file names: safe to cache for a year.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # The entry page must be revalidated so a new deployment is picked up at once.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    location / {
        try_files $uri /index.html;
    }
}
