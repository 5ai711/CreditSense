# Copy to .env and change before deploying anywhere but your own machine.
DB_PASSWORD=creditsense
JWT_SECRET=replace-with-at-least-32-random-bytes-of-secret
ML_SERVICE_TOKEN=replace-with-a-random-service-token
SEED_DEMO_DATA=true
# Optuna trials when retraining (0 = reuse the champion's tuned hyperparameters)
ML_RETRAIN_TRIALS=0
